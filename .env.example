# Conversion tracking — leave unset and nothing loads (no consent banner needed).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# Where enquiry form submissions are stored.
# A Google Apps Script web app bound to a spreadsheet — see README.
# Server-side only: no NEXT_PUBLIC prefix, so the URL never reaches the browser.
# ENQUIRY_WEBHOOK_URL=https://script.google.com/macros/s/AKfy.../exec

# Transactional email on lead arrival (Resend). Unset = nothing is sent.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Verify your domain in Resend, then use an address on it so replies work
# and mail doesn't land in spam:
# LEAD_FROM=Infinity Space <hello@infinityspace4u.com>
# Where the owner notification goes; defaults to site.contact.email.
# LEAD_NOTIFY_TO=contact@infinityspace4u.com
